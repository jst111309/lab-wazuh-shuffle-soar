# Copy this file to .env:  cp .env.example .env
# Values below are the official wazuh-docker defaults — LAB USE ONLY.
WAZUH_VERSION=4.14.10

# Wazuh Indexer admin (also dashboard login at https://localhost).
# Changing it also requires a new hash in wazuh/config/wazuh_indexer/internal_users.yml
INDEXER_USERNAME=admin
INDEXER_PASSWORD=SecretPassword

# Dashboard -> indexer internal user
DASHBOARD_USERNAME=kibanaserver
DASHBOARD_PASSWORD=kibanaserver

# Wazuh API user (dashboard & Shuffle). Must match wazuh/config/wazuh_dashboard/wazuh.yml
API_USERNAME=wazuh-wui
API_PASSWORD=MyS3cr37P450r.*-
