# Rule deteksi port scanning (skenario 6) — sid 1000001-1000099
#
# SYN scan (nmap -sS / -sT): >= 20 paket SYN dari satu IP dalam 10 detik.
# Port 22 dikecualikan supaya brute force SSH (hydra) tidak ikut terhitung scan.
# "type both" = maksimal 1 alert per IP per 10 detik (tidak membanjiri Wazuh).
alert tcp any any -> $HOME_NET !22 (msg:"CLO3 SCAN TCP SYN port scan"; flow:stateless; flags:S,12; threshold:type both, track by_src, count 20, seconds 10; classtype:attempted-recon; sid:1000001; rev:1;)

# NULL scan (nmap -sN): paket TCP tanpa flag sama sekali
alert tcp any any -> $HOME_NET any (msg:"CLO3 SCAN TCP NULL scan"; flow:stateless; flags:0; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000002; rev:1;)

# FIN scan (nmap -sF): hanya flag FIN
alert tcp any any -> $HOME_NET any (msg:"CLO3 SCAN TCP FIN scan"; flow:stateless; flags:F,12; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000003; rev:1;)

# XMAS scan (nmap -sX): flag FIN+PSH+URG
alert tcp any any -> $HOME_NET any (msg:"CLO3 SCAN TCP XMAS scan"; flow:stateless; flags:FPU,12; threshold:type both, track by_src, count 5, seconds 10; classtype:attempted-recon; sid:1000004; rev:1;)
